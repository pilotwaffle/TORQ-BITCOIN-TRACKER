# TBWI - Environment Configuration Template
# Copy this file to .env and customize for your environment

# =============================================================================
# General Settings
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# =============================================================================
# Bitcoin Core Configuration
# =============================================================================
BITCOIN_NETWORK=testnet
BITCOIN_RPC_USER=btcuser
BITCOIN_RPC_PASSWORD=btcpass
BITCOIN_RPC_HOST=localhost
BITCOIN_RPC_PORT=18332
BITCOIN_ZMQ_TX_ENDPOINT=tcp://localhost:28332
BITCOIN_ZMQ_BLOCK_ENDPOINT=tcp://localhost:28333

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tbwi
DB_USER=tbwi
DB_PASSWORD=tbwi_secret

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Uncomment and set if Redis requires authentication

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# API_API_KEY=  # Uncomment and set to require API key authentication
API_CORS_ORIGINS=*

# =============================================================================
# Transaction Thresholds
# =============================================================================
# Minimum transaction value (in BTC) to process
MIN_TX_THRESHOLD_BTC=10

# Threshold for classifying a transaction as "large"
LARGE_TX_THRESHOLD_BTC=50

# Single deposit event threshold
SINGLE_DEPOSIT_THRESHOLD_BTC=1000

# Deposit burst detection
DEPOSIT_BURST_MIN_COUNT=10
DEPOSIT_BURST_MIN_BTC=1000
DEPOSIT_BURST_WINDOW_MINUTES=10

# Exchange outflow detection
OUTFLOW_MIN_COUNT=3
OUTFLOW_MIN_BTC=10000
OUTFLOW_WINDOW_MINUTES=30

# =============================================================================
# Price Oracle Configuration
# =============================================================================
PRICE_ENABLED=true
# Uses CoinGecko by default
# PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd
PRICE_CACHE_TTL_SECONDS=60

# =============================================================================
# Webhook Configuration
# =============================================================================
WEBHOOK_ENABLED=true
# Comma-separated list of webhook URLs
# WEBHOOK_URLS=https://n8n.example.com/webhook/tbwi,https://other.example.com/hook
WEBHOOK_URLS=
WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY_SECONDS=1.0
